From 2a16bc25280ce0bd7d211266c9207b712855d5af Mon Sep 17 00:00:00 2001
From: Jetha Chan <jethachan@gmail.com>
Date: Wed, 4 Nov 2026 18:03:36 +0900
Subject: [PATCH 206/206] arm64: dts: qcom: msm8953: add the APSS watchdog

Describe the APSS watchdog (bark on SPI 3, bite on SPI 4, clocked from the
32 kHz sleep clock) so a wedged kernel resets the SoC instead of needing a
power cycle. The address and interrupts follow the vendor msm8953 tree.
---
 arch/arm64/boot/dts/qcom/msm8953.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8953.dtsi b/arch/arm64/boot/dts/qcom/msm8953.dtsi
index a71900116..f0d011619 100644
--- a/arch/arm64/boot/dts/qcom/msm8953.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8953.dtsi
@@ -2899,6 +2899,14 @@ apcscc: clock-controller@b011050 {
 			#interconnect-cells = <1>;
 		};
 
+		watchdog@b017000 {
+			compatible = "qcom,apss-wdt-msm8953", "qcom,kpss-wdt";
+			reg = <0x0b017000 0x1000>;
+			interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>,
+				     <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&sleep_clk>;
+		};
+
 		cpr: power-controller@b018000 {
 			compatible = "qcom,msm8953-cpr4pd";
 
-- 
