+	/*
+	 * Front camera rails. Stock camera@0 turns these on in the order
+	 * cam_vana (L17, 2.85 V) + GPIO 119 "CAM_VANA", then cam_vdig
+	 * (L2 at 1.2 V) + GPIO 118 "CAM_VDIG", then cam_vio (L6, 1.8 V).
+	 * The GPIOs gate the PMIC LDOs onto the module.
+	 */
+	cam_vdda: cam-vdda-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vdda";
+		regulator-min-microvolt = <2850000>;
+		regulator-max-microvolt = <2850000>;
+
+		gpio = <&tlmm 119 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8953_l17>;
+
+		pinctrl-0 = <&cam_vdda_en_default>;
+		pinctrl-names = "default";
+	};
+
+	cam_vddd: cam-vddd-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_vddd";
+		regulator-min-microvolt = <1200000>;
+		regulator-max-microvolt = <1200000>;
+
+		gpio = <&tlmm 118 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&pm8953_l2>;
+
+		pinctrl-0 = <&cam_vddd_en_default>;
+		pinctrl-names = "default";
+	};
+
