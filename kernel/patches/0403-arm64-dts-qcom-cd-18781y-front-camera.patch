+&camss {
+	vdda-supply = <&pm8953_s3>;
+
+	status = "okay";
+
+	ports {
+		/*
+		 * Stock: CSIPHY 0 / CSID 0, LaneMask 0x7 and LaneAssign 0x4320
+		 * in downstream numbering (0 = D0, 1 = CLK, 2 = D1), i.e. two
+		 * data lanes on D0 and D1. The 3-phase CSIPHY driver numbers
+		 * data lanes 0-3 and always uses lane 7 for the clock.
+		 */
+		port@0 {
+			reg = <0>;
+
+			csiphy0_ep: endpoint {
+				clock-lanes = <7>;
+				data-lanes = <0 1>;
+				remote-endpoint = <&front_cam_ep>;
+			};
+		};
+	};
+};
+
+&cci {
+	status = "okay";
+};
+
+&cci_i2c0 {
+	/*
+	 * 8-bit address 0x6e in the vendor sensor library; the module was
+	 * seen answering at 0x37 on a powered probe.
+	 */
+	camera@37 {
+		compatible = "samsung,s5kc505a";
+		reg = <0x37>;
+
+		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		reset-gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+		powerdown-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&camss_mclk0_default &cam_front_default>;
+		pinctrl-names = "default";
+
+		/* Voltages from stock camera@0; do not change */
+		vdda-supply = <&cam_vdda>;
+		vddd-supply = <&cam_vddd>;
+		vddio-supply = <&pm8953_l6>;
+
+		orientation = <0>;	/* front */
+		rotation = <270>;
+
+		port {
+			front_cam_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <480000000>;
+				remote-endpoint = <&csiphy0_ep>;
+			};
+		};
+	};
+};
+
