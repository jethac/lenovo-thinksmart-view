+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5kc505a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5KC505A Image Sensor
+
+description:
+  Samsung S5KC505A is a 5MP (2608x1960 active, 1.4 um pixel) raw Bayer image
+  sensor with a SMIA-style register map, controlled over a serial camera
+  control bus. The widest frame is 2608x1960 at 30 frames per second, output
+  as RAW10 over a 2-lane MIPI CSI-2 D-PHY interface.
+
+maintainers:
+  - jethac <jethacjp@gmail.com>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5kc505a
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock, 24 MHz.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESET pad of the sensor.
+    maxItems: 1
+
+  powerdown-gpios:
+    description:
+      Active low GPIO holding the module in standby; driven high, after
+      reset is released, for normal operation.
+    maxItems: 1
+
+  vdda-supply:
+    description: Analogue voltage supply, 2.85 volts.
+
+  vddd-supply:
+    description: Digital core voltage supply, 1.2 volts.
+
+  vddio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+
+        required:
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - reset-gpios
+  - vdda-supply
+  - vddd-supply
+  - vddio-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+      #include <dt-bindings/gpio/gpio.h>
+
+      i2c {
+          #address-cells = <1>;
+          #size-cells = <0>;
+
+          camera@37 {
+              compatible = "samsung,s5kc505a";
+              reg = <0x37>;
+              clocks = <&camera_mclk 0>;
+              assigned-clocks = <&camera_mclk 0>;
+              assigned-clock-rates = <24000000>;
+              reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+              powerdown-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
+              vdda-supply = <&vreg_2p85>;
+              vddd-supply = <&vreg_1p2>;
+              vddio-supply = <&vreg_1p8>;
+              orientation = <0>;
+              rotation = <270>;
+
+              port {
+                  endpoint {
+                      data-lanes = <1 2>;
+                      link-frequencies = /bits/ 64 <480000000>;
+                      remote-endpoint = <&mipi_csi2_ep>;
+                  };
+              };
+          };
+      };
+...
