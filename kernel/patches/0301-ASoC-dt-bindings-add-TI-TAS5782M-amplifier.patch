From 2e77a2593d7495abf7bfa0530e45abd61065ae62 Mon Sep 17 00:00:00 2001
From: Jetha Chan <jethachan@gmail.com>
Date: Fri, 30 Oct 2026 21:39:03 +0900
Subject: [PATCH 301/303] ASoC: dt-bindings: add TI TAS5782M amplifier

The TAS5782M is a stereo class-D amplifier with an I2S input and an
integrated DSP running a ROM process flow. The DSP coefficients (speaker
EQ, limiter, excursion protection) are specific to each product and are
produced with TI's PPC3 tool, so the binding names a configuration
(ti,dsp-config-name) that the driver loads as a firmware file, the same
way as the existing ti,tas5805m binding.

PVDD is required. DVDD/AVDD, the power-down GPIO and the fault GPIO are
optional: on the Lenovo ThinkSmart View only the PVDD rail is switched
by the SoC.

---
 .../bindings/sound/ti,tas5782m.yaml           | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/ti,tas5782m.yaml

diff --git a/Documentation/devicetree/bindings/sound/ti,tas5782m.yaml b/Documentation/devicetree/bindings/sound/ti,tas5782m.yaml
new file mode 100644
index 000000000..1aa936618
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/ti,tas5782m.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/ti,tas5782m.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Texas Instruments TAS5782M stereo class-D amplifier
+
+maintainers:
+  - Jetha Chan <jethachan@gmail.com>
+
+description: |
+  The TAS5782M is a stereo class-D amplifier with a digital audio input
+  and an integrated DSP. The DSP coefficients (speaker EQ, limiter and
+  protection) are product specific. They are loaded at start-up from a
+  firmware file, tas5782m_dsp_<name>.bin, a sequence of register writes
+  generated from TI's PPC3 tool, where <name> comes from
+  ti,dsp-config-name.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: ti,tas5782m
+
+  reg:
+    maxItems: 1
+    description: |
+      I2C address of the amplifier, set by the ADR pins (0x48 to 0x4b).
+
+  dvdd-supply:
+    description: Digital supply (DVDD).
+
+  avdd-supply:
+    description: Analog supply (AVDD).
+
+  pvdd-supply:
+    description: Power stage supply (PVDD).
+
+  powerdown-gpios:
+    maxItems: 1
+    description: |
+      GPIO driving the power-down pin. Asserted holds the device in
+      power down.
+
+  fault-gpios:
+    maxItems: 1
+    description: |
+      GPIO connected to the fault output (SPK_FAULT). Asserted means the
+      power stage has shut down on a fault.
+
+  ti,dsp-config-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: |
+      Name of the DSP configuration for this instance. The driver loads
+      tas5782m_dsp_<name>.bin. Defaults to "default".
+
+  '#sound-dai-cells':
+    const: 0
+
+required:
+  - compatible
+  - reg
+  - pvdd-supply
+  - '#sound-dai-cells'
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        amplifier@49 {
+            compatible = "ti,tas5782m";
+            reg = <0x49>;
+            pvdd-supply = <&speaker_pvdd>;
+            fault-gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
+            ti,dsp-config-name = "lenovo_cd-18781y";
+            sound-name-prefix = "Speaker Amp";
+            #sound-dai-cells = <0>;
+        };
+    };
-- 
