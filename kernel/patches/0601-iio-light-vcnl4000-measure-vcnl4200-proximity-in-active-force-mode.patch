iio: light: vcnl4000: measure VCNL4200/4040 proximity in active force mode

The driver runs the proximity side in normal mode: whenever the chip is
powered (which includes every ambient light read and the 2 s autosuspend
delay after any read) the IR LED pulses continuously at PS_DUTY, with the
8 pulses and 120 mA that init writes. Put the proximity side in active force
mode instead: a proximity read writes PS_TRIG, waits for the one measurement
(9-10 ms on a VCNL4200, measured, whatever the integration time, duty or
pulse count; 20 ms allowed) and reads PS_DATA. Nothing else lights the LED,
and a reader that dies leaves it dark.

Threshold events need continuous measurement, so enabling a proximity event
switches back to normal mode, and disabling it returns to active force mode.

Tested on a VCNL4200 (Lenovo ThinkSmart View): PS_CONF3 reads AF set after
probe; with 8 pulses at 9T left in PS_DATA, three seconds of ambient light
reads (chip powered, PS_SD clear) leave PS_DATA unchanged, so no normal-mode
cycle ran; each proximity read takes about 25 ms.

diff --git i/drivers/iio/light/vcnl4000.c w/drivers/iio/light/vcnl4000.c
index 336468d59..614de5816 100644
--- i/drivers/iio/light/vcnl4000.c
+++ w/drivers/iio/light/vcnl4000.c
@@ -95,6 +95,8 @@
 #define VCNL4040_PS_CONF2_PS_HD		BIT(11)	/* Proximity high definition */
 #define VCNL4040_PS_CONF2_PS_INT	GENMASK(9, 8) /* Proximity interrupt mode */
 #define VCNL4040_PS_CONF3_MPS		GENMASK(6, 5) /* Proximity multi pulse number */
+#define VCNL4040_PS_CONF3_PS_AF		BIT(3) /* Proximity active force mode */
+#define VCNL4040_PS_CONF3_PS_TRIG	BIT(2) /* Proximity one-shot trigger */
 #define VCNL4040_PS_MS_LED_I		GENMASK(10, 8) /* Proximity current */
 #define VCNL4040_PS_IF_AWAY		BIT(8) /* Proximity event cross low threshold */
 #define VCNL4040_PS_IF_CLOSE		BIT(9) /* Proximity event cross high threshold */
@@ -186,6 +188,13 @@ static const int vcnl4040_ps_oversampling_ratio[] = {1, 2, 4, 8};
 
 #define VCNL4000_SLEEP_DELAY_MS	2000 /* before we enter pm_runtime_suspend */
 
+/*
+ * In active force mode a measurement is made only when PS_TRIG is written.
+ * Measured on a VCNL4200: the result is in PS_DATA 9-10 ms after the trigger,
+ * whatever the integration time, duty ratio or number of pulses.
+ */
+#define VCNL4200_PS_AF_WAIT_US	20000
+
 struct vcnl4200_channel {
 	u8 reg;
 	ktime_t last_measurement;
@@ -398,7 +407,13 @@ static int vcnl4200_init(struct vcnl4000_data *data)
 	if (ret < 0)
 		return ret;
 
-	regval = ret | VCNL4040_CONF3_PS_SAMPLE_16BITS;
+	/*
+	 * Active force mode: the IR LED is pulsed only for a proximity read,
+	 * not continuously while the sensor is powered (which includes every
+	 * ambient light read). Normal mode is used only while a proximity
+	 * event is enabled, see vcnl4200_set_ps_af().
+	 */
+	regval = ret | VCNL4040_CONF3_PS_SAMPLE_16BITS | VCNL4040_PS_CONF3_PS_AF;
 	ret = i2c_smbus_write_word_data(client, VCNL4200_PS_CONF3, regval);
 	if (ret < 0)
 		return ret;
@@ -406,6 +421,24 @@ static int vcnl4200_init(struct vcnl4000_data *data)
 	return 0;
 };
 
+/* Caller holds vcnl4000_lock. */
+static int vcnl4200_set_ps_af(struct vcnl4000_data *data, bool af)
+{
+	int ret;
+
+	ret = i2c_smbus_read_word_data(data->client, VCNL4200_PS_CONF3);
+	if (ret < 0)
+		return ret;
+
+	ret &= ~VCNL4040_PS_CONF3_PS_TRIG;
+	if (af)
+		ret |= VCNL4040_PS_CONF3_PS_AF;
+	else
+		ret &= ~VCNL4040_PS_CONF3_PS_AF;
+
+	return i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF3, ret);
+}
+
 static int vcnl4000_read_data(struct vcnl4000_data *data, u8 data_reg, int *val)
 {
 	s32 ret;
@@ -505,7 +538,33 @@ static int vcnl4000_measure_proximity(struct vcnl4000_data *data, int *val)
 
 static int vcnl4200_measure_proximity(struct vcnl4000_data *data, int *val)
 {
-	return vcnl4200_measure(data, &data->vcnl4200_ps, val);
+	int ret;
+
+	if (data->ps_int)
+		return vcnl4200_measure(data, &data->vcnl4200_ps, val);
+
+	/* Active force mode: one measurement, one burst of the IR LED. */
+	scoped_guard(mutex, &data->vcnl4000_lock) {
+		ret = i2c_smbus_read_word_data(data->client, VCNL4200_PS_CONF3);
+		if (ret < 0)
+			return ret;
+
+		ret = i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF3,
+						ret | VCNL4040_PS_CONF3_PS_AF |
+						VCNL4040_PS_CONF3_PS_TRIG);
+		if (ret < 0)
+			return ret;
+
+		fsleep(VCNL4200_PS_AF_WAIT_US);
+
+		ret = i2c_smbus_read_word_data(data->client, VCNL4200_PS_DATA);
+		if (ret < 0)
+			return ret;
+	}
+
+	*val = ret;
+
+	return 0;
 }
 
 static int vcnl4010_read_proxy_samp_freq(struct vcnl4000_data *data, int *val,
@@ -1445,6 +1504,11 @@ static int vcnl4040_write_event_config(struct iio_dev *indio_dev,
 
 		val = state ? (ret | mask) : (ret & ~mask);
 
+		/* Threshold interrupts need continuous (normal mode) measurement. */
+		ret = vcnl4200_set_ps_af(data, !FIELD_GET(VCNL4040_PS_CONF2_PS_INT, val));
+		if (ret < 0)
+			return ret;
+
 		data->ps_int = FIELD_GET(VCNL4040_PS_CONF2_PS_INT, val);
 		return i2c_smbus_write_word_data(data->client, VCNL4200_PS_CONF1, val);
 	default:
