# Lenovo ThinkSmart View CD-18781Y, on top of defconfig + msm8953.config + no-unused-drivers.config

# Display: both buildable panel variants (JD9365 driver is not wired into Kconfig yet).
# Modules, because msm8953.config builds DRM as a module.
CONFIG_DRM_PANEL_LENOVO_CD_18781Y_FT8201=m
CONFIG_DRM_PANEL_LENOVO_CD_18781Y_HX83100A=m
CONFIG_BACKLIGHT_QCOM_WLED=m

# Touch: FT8201 (this unit) and HX83100A
CONFIG_TOUCHSCREEN_EDT_FT5X06=m
CONFIG_TOUCHSCREEN_HIMAX_HX83112B=m

# Wi-Fi: QCA9379 over SDIO
CONFIG_ATH10K=m
CONFIG_ATH10K_SDIO=m

# Bluetooth: QCA9379 over UART
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y

# USB gadget networking (172.16.42.1) and serial fallback
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y

# Sensors on the bit-banged bus
CONFIG_I2C_GPIO=y
CONFIG_BMC150_ACCEL=m
# VCNL4200 driver left off on purpose: see devices/proximity-light (IR LED hazard)
# CONFIG_VCNL4000 is not set

# Camera subsystem (sensor driver still to be written)
CONFIG_VIDEO_QCOM_CAMSS=m

# Panel supplies (vsp/vsn) come from the PMI8950 LAB/IBB regulators; without this the panel never probes
CONFIG_REGULATOR_QCOM_LABIBB=y

# Debug console
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Memory pressure on 2 GB with the speech models resident: compressed swap
# in RAM, and pressure stall information for systemd-oomd.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_PSI=y
