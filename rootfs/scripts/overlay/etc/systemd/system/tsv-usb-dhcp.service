[Unit]
Description=DHCP server for USB gadget networking (172.16.42.0/24)
After=tsv-usb-gadget.service
Wants=tsv-usb-gadget.service

[Service]
ExecStart=/usr/bin/dnsmasq --keep-in-foreground --conf-file=/etc/tsv/usb-dnsmasq.conf --pid-file
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
