# CMake toolchain: host clang + lld, aarch64 glibc, fully static, tuned for
# Cortex-A53 (ARMv8.0-A: NEON, no dotprod, no i8mm, no fp16 arithmetic).
# Pass -DTSV_SYSROOT=<dir from make-sysroot.sh>.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TSV_SYSROOT)
if(NOT TSV_SYSROOT)
    set(TSV_SYSROOT "$ENV{TSV_SYSROOT}")
endif()
set(CMAKE_SYSROOT "${TSV_SYSROOT}")
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(TSV_CPU_FLAGS "-mcpu=cortex-a53" CACHE STRING "CPU tuning flags")
set(CMAKE_C_FLAGS_INIT "${TSV_CPU_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${TSV_CPU_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -static --rtlib=libgcc")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH "${TSV_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
