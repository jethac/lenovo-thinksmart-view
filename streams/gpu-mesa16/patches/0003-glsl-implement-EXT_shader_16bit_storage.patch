+u16vec2		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_u16vec2);
+u16vec3		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_u16vec3);
+u16vec4		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_u16vec4);
+
     /* Additional words for AMD_gpu_shader_half_float */
-float16_t	TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_float16_t);
-f16vec2		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_f16vec2);
-f16vec3		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_f16vec3);
-f16vec4		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_f16vec4);
+float16_t	TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable || yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_float16_t);
+f16vec2		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable || yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_f16vec2);
+f16vec3		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable || yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_f16vec3);
+f16vec4		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable || yyextra->EXT_shader_16bit_storage_enable, &glsl_type_builtin_f16vec4);
 f16mat2		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_f16mat2);
 f16mat3		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_f16mat3);
 f16mat4		TYPE_WITH_ALT(0, 0, 0, 0, yyextra->AMD_gpu_shader_half_float_enable, &glsl_type_builtin_f16mat4);
