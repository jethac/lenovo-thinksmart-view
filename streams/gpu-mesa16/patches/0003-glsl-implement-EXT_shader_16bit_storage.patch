 {
@@ -940,6 +948,15 @@ convert_component(ir_rvalue *src, const glsl_type *desired_type)
       case GLSL_TYPE_IMAGE:
          result = new(linalloc) ir_expression(ir_unop_unpack_image_2x32, src);
          break;
+      case GLSL_TYPE_UINT16:
+         result = new(linalloc) ir_expression(ir_unop_u2u, desired_type, src, NULL);
+         break;
+      case GLSL_TYPE_INT16:
+         result = new(linalloc) ir_expression(ir_unop_i2u,
+                     new(linalloc) ir_expression(ir_unop_i2i,
+                                                 convert_type(GLSL_TYPE_INT, src),
+                                                 src, NULL));
+         break;
       }
       break;
    case GLSL_TYPE_INT:
@@ -965,6 +982,37 @@ convert_component(ir_rvalue *src, const glsl_type *desired_type)
       case GLSL_TYPE_INT64:
          result = new(linalloc) ir_expression(ir_unop_i642i, src);
          break;
+      case GLSL_TYPE_INT16:
+         result = new(linalloc) ir_expression(ir_unop_i2i, desired_type, src, NULL);
+         break;
+      case GLSL_TYPE_UINT16:
+         result = new(linalloc) ir_expression(ir_unop_u2i,
+                     new(linalloc) ir_expression(ir_unop_u2u,
+                                                 convert_type(GLSL_TYPE_UINT, src),
+                                                 src, NULL));
+         break;
+      }
+      break;
+   case GLSL_TYPE_INT16:
+      switch (b) {
+      case GLSL_TYPE_INT:
+         result = new(linalloc) ir_expression(ir_unop_i2i, desired_type, src, NULL);
+         break;
+      case GLSL_TYPE_UINT:
+         result = new(linalloc) ir_expression(ir_unop_i2i, desired_type,
+                     new(linalloc) ir_expression(ir_unop_u2i, src), NULL);
+         break;
+      }
+      break;
+   case GLSL_TYPE_UINT16:
+      switch (b) {
+      case GLSL_TYPE_UINT:
+         result = new(linalloc) ir_expression(ir_unop_u2u, desired_type, src, NULL);
+         break;
+      case GLSL_TYPE_INT:
+         result = new(linalloc) ir_expression(ir_unop_u2u, desired_type,
+                     new(linalloc) ir_expression(ir_unop_i2u, src), NULL);
+         break;
       }
       break;
    case GLSL_TYPE_FLOAT16:
@@ -2160,6 +2208,37 @@ static inline bool is_valid_constructor(const glsl_type *type,
           (state->has_bindless() && (glsl_type_is_sampler(type) || glsl_type_is_image(type)));
 }
 
+/**
+ * EXT_shader_16bit_storage only allows constructors that convert 16-bit
+ * types to and from 32-bit ones: float16_t <-> float and int16_t, uint16_t
+ * <-> int, uint.  AMD_gpu_shader_half_float allows any conversion to and
+ * from float16_t.
+ */
+static bool
+is_valid_16bit_conversion(const glsl_type *to, const glsl_type *from,
+                          struct _mesa_glsl_parse_state *state)
+{
+   const enum glsl_base_type a = to->base_type, b = from->base_type;
+
+   if (a == b || !(glsl_base_type_bit_size(a) == 16 ||
+                   glsl_base_type_bit_size(b) == 16))
+      return true;
+
+   if (state->AMD_gpu_shader_half_float_enable &&
+       (a == GLSL_TYPE_FLOAT16 || b == GLSL_TYPE_FLOAT16))
+      return true;
+
+   if (a == GLSL_TYPE_FLOAT16 || b == GLSL_TYPE_FLOAT16)
+      return a == GLSL_TYPE_FLOAT || b == GLSL_TYPE_FLOAT;
+
+   const bool a_int = a == GLSL_TYPE_INT || a == GLSL_TYPE_UINT ||
+                      a == GLSL_TYPE_INT16 || a == GLSL_TYPE_UINT16;
+   const bool b_int = b == GLSL_TYPE_INT || b == GLSL_TYPE_UINT ||
+                      b == GLSL_TYPE_INT16 || b == GLSL_TYPE_UINT16;
+   return a_int && b_int &&
+          glsl_base_type_bit_size(a) != glsl_base_type_bit_size(b);
+}
+
 ir_rvalue *
 ast_function_expression::hir(ir_exec_list *instructions,
                              struct _mesa_glsl_parse_state *state)
@@ -2285,6 +2364,13 @@ ast_function_expression::hir(ir_exec_list *instructions,
             return ir_rvalue::error_value(state->linalloc);
          }
 
+         if (!is_valid_16bit_conversion(constructor_type, result->type, state)) {
+            _mesa_glsl_error(& loc, state, "cannot construct `%s' from `%s'",
+                             glsl_get_type_name(constructor_type),
+                             glsl_get_type_name(result->type));
+            return ir_rvalue::error_value(state->linalloc);
+         }
+
          /* Count the number of matrix and nonmatrix parameters.  This
           * is used below to enforce some of the constructor rules.
           */
diff --git a/src/compiler/glsl/ast_to_hir.cpp b/src/compiler/glsl/ast_to_hir.cpp
index bc46e92..a926ea9 100644
--- a/src/compiler/glsl/ast_to_hir.cpp
+++ b/src/compiler/glsl/ast_to_hir.cpp
@@ -364,6 +364,38 @@ apply_implicit_conversion(const glsl_type *to, ir_rvalue * &from,
 }
 
 
+/**
+ * Whether \c type is or contains a 16-bit type that the enabled extensions
+ * only allow in uniform and buffer storage: EXT_shader_16bit_storage
+ * types may be loaded, stored and converted to and from 32-bit types, but
+ * not declared as other variables or used in arithmetic.
+ * AMD_gpu_shader_half_float makes float16_t a full arithmetic type.
+ */
+static bool
+is_storage_only_16bit_type(const glsl_type *type,
+                           const struct _mesa_glsl_parse_state *state)
+{
+   type = glsl_without_array(type);
+
+   if (glsl_type_is_struct(type)) {
+      for (unsigned i = 0; i < type->length; i++) {
+         if (is_storage_only_16bit_type(type->fields.structure[i].type, state))
+            return true;
+      }
+      return false;
+   }
+
+   switch (type->base_type) {
+   case GLSL_TYPE_FLOAT16:
+      return !state->AMD_gpu_shader_half_float_enable;
+   case GLSL_TYPE_INT16:
+   case GLSL_TYPE_UINT16:
+      return true;
+   default:
+      return false;
+   }
+}
+
 static const struct glsl_type *
 arithmetic_result_type(ir_rvalue * &value_a, ir_rvalue * &value_b,
                        bool multiply,
@@ -384,6 +416,13 @@ arithmetic_result_type(ir_rvalue * &value_a, ir_rvalue * &value_b,
       return &glsl_type_builtin_error;
    }
 
+   if (is_storage_only_16bit_type(type_a, state) ||
+       is_storage_only_16bit_type(type_b, state)) {
+      _mesa_glsl_error(loc, state, "16-bit types must be converted to "
+                       "32-bit types before arithmetic");
+      return &glsl_type_builtin_error;
+   }
+
 
    /*    "If one operand is floating-point based and the other is
     *    not, then the conversions from Section 4.1.10 "Implicit
@@ -523,6 +562,12 @@ unary_arithmetic_result_type(const struct glsl_type *type,
       return &glsl_type_builtin_error;
    }
 
+   if (is_storage_only_16bit_type(type, state)) {
+      _mesa_glsl_error(loc, state, "16-bit types must be converted to "
+                       "32-bit types before arithmetic");
+      return &glsl_type_builtin_error;
+   }
+
    return type;
 }
 
@@ -713,6 +758,13 @@ relational_result_type(ir_rvalue * &value_a, ir_rvalue * &value_b,
       return &glsl_type_builtin_error;
    }
 
+   if (is_storage_only_16bit_type(type_a, state) ||
+       is_storage_only_16bit_type(type_b, state)) {
+      _mesa_glsl_error(loc, state, "16-bit types must be converted to "
+                       "32-bit types before comparison");
+      return &glsl_type_builtin_error;
+   }
+
    /*    "Either the operands' types must match, or the conversions from
     *    Section 4.1.10 "Implicit Conversions" will be applied to the integer
     *    operand, after which the types must match."
@@ -5365,6 +5417,19 @@ ast_declarator_list::hir(ir_exec_list *instructions,
                        "interface blocks");
    }
 
+   /* EXT_shader_16bit_storage:
+    *    "...must not be used to declare variables, unless that variable is
+    *    a structure with uniform or buffer storage qualifier."
+    *
+    * Members of uniform and buffer blocks are not declared here.
+    */
+   if (decl_type && !this->declarations.is_empty() &&
+       is_storage_only_16bit_type(decl_type, state)) {
+      _mesa_glsl_error(&loc, state,
+                       "16-bit types can only be used in uniform and buffer "
+                       "blocks");
+   }
+
    /* Similarly, the EXT_shader_pixel_local_storage spec says:
     *    "Pixel local storage variables may only be declared inside
     *     interface blocks..."
