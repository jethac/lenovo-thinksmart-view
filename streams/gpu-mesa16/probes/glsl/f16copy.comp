#version 310 es
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 8) in;
layout(std430, binding = 0) readonly buffer I { float16_t a[]; };
layout(std430, binding = 1) writeonly buffer O { float16_t b[]; };
void main() { uint i = gl_LocalInvocationID.x; b[i] = float16_t(float(a[i]) * 2.0); }
