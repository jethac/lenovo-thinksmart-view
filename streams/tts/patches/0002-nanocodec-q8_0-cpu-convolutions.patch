+static bool
+nc_cpu_q8_enabled() {
+    const char* e = std::getenv("NANOCODEC_CPU_Q8");
+    return e && e[0] == '1';
+}
+
+// Q8_0 copies of the CPU conv weights (NANOCODEC_CPU_Q8=1): stride-1 convolutions with
+// K * Cin a multiple of the Q8_0 block, and the transposed convolutions' GEMM weights (wt_cpu,
+// rows padded to a whole block).
+static void
+nc_prepare_cpu_q8_weights(nc_model& model, bool verbose) {
+    if (!model.backend || !ggml_backend_is_cpu(model.backend) || !nc_cpu_q8_enabled()) {
+        return;
+    }
+    const int64_t qk = ggml_blck_size(GGML_TYPE_Q8_0);
+    std::vector<nc_conv*> convs, transposed;
+    auto consider = [&](nc_conv& c) {
+        if (c.w && c.w->type == GGML_TYPE_F16 && c.stride == 1 && ggml_is_contiguous(c.w)) {
+            convs.push_back(&c);
+        }
+    };
+    consider(model.pre_conv);
+    for (nc_res_layer& layer : model.res_layers) {
+        for (auto& stack : layer.by_kernel) {
+            for (nc_res_block& block : stack) {
+                consider(block.input_conv);
+                consider(block.skip_conv);
+            }
+        }
+    }
+    consider(model.post_conv);
+    for (nc_conv& c : model.up_convs) {
+        if (c.wt_cpu && c.wt_cpu->ne[0] % qk == 0) {
+            transposed.push_back(&c);
+        }
+    }
+    if (convs.empty() && transposed.empty()) {
+        return;
+    }
+    ggml_init_params params = {
+        ggml_tensor_overhead() * (2 * convs.size() + transposed.size() + 1), nullptr, true};
+    model.cpu_q8_ctx = ggml_init(params);
+    // Input channels are zero-padded to a multiple of the block so that every row (K * Cin) is
+    // whole blocks; the kernel sizes are odd.
+    std::vector<ggml_tensor*> qc, qs, qt;
+    for (nc_conv* c : convs) {
+        const int64_t cin_pad = (c->w->ne[1] + qk - 1) / qk * qk;
+        ggml_tensor* t = ggml_new_tensor_2d(
+            model.cpu_q8_ctx, GGML_TYPE_Q8_0, c->w->ne[0] * cin_pad, c->w->ne[2]);
+        ggml_set_name(t, (std::string(ggml_get_name(c->w)) + ".q8").c_str());
+        qc.push_back(t);
+        ggml_tensor* sh = ggml_new_tensor_2d(model.cpu_q8_ctx, GGML_TYPE_F16, c->w->ne[0], cin_pad);
+        ggml_set_name(sh, (std::string(ggml_get_name(c->w)) + ".q8shape").c_str());
+        qs.push_back(sh);
+    }
+    for (nc_conv* c : transposed) {
+        ggml_tensor* t = ggml_new_tensor_2d(
+            model.cpu_q8_ctx, GGML_TYPE_Q8_0, c->wt_cpu->ne[0], c->wt_cpu->ne[1]);
+        ggml_set_name(t, (std::string(ggml_get_name(c->wt_cpu)) + ".q8").c_str());
+        qt.push_back(t);
+    }
+    model.cpu_q8_buffer = ggml_backend_alloc_ctx_tensors(model.cpu_q8_ctx, model.backend);
+    if (!model.cpu_q8_buffer) {
+        fprintf(stderr, "warning: could not allocate Q8_0 NanoCodec conv weights\n");
+        ggml_free(model.cpu_q8_ctx);
+        model.cpu_q8_ctx = nullptr;
+        return;
+    }
+    std::vector<ggml_fp16_t> h;
+    std::vector<float> f;
+    std::vector<uint8_t> q;
+    auto quantize = [&](ggml_tensor* dst, int64_t nrows, int64_t n_per_row) {
+        q.resize(ggml_row_size(GGML_TYPE_Q8_0, n_per_row) * nrows);
+        ggml_quantize_chunk(GGML_TYPE_Q8_0, f.data(), q.data(), 0, nrows, n_per_row, nullptr);
+        ggml_backend_tensor_set(dst, q.data(), 0, q.size());
+    };
+    for (size_t i = 0; i < convs.size(); ++i) {
+        nc_conv* c = convs[i];
+        // [K, Cin, Cout] contiguous: row co is (ci * K + k), the order of ggml_im2col's columns.
+        const int64_t K = c->w->ne[0], cin = c->w->ne[1], cout = c->w->ne[2];
+        const int64_t cin_pad = qs[i]->ne[1];
+        h.resize((size_t)ggml_nelements(c->w));
+        ggml_backend_tensor_get(c->w, h.data(), 0, h.size() * sizeof(ggml_fp16_t));
+        f.assign((size_t)(K * cin_pad * cout), 0.0f);
+        for (int64_t co = 0; co < cout; ++co) {
+            for (int64_t j = 0; j < cin * K; ++j) {
+                f[(size_t)(co * cin_pad * K + j)] = ggml_fp16_to_fp32(h[(size_t)(co * cin * K + j)]);
+            }
+        }
+        quantize(qc[i], cout, K * cin_pad);
+        c->wq_cpu = qc[i];
+        c->wq_shape = qs[i];
+        c->w_cpu = nullptr;
+    }
+    for (size_t i = 0; i < transposed.size(); ++i) {
+        nc_conv* c = transposed[i];
+        f.resize((size_t)ggml_nelements(c->wt_cpu));
+        ggml_backend_tensor_get(c->wt_cpu, f.data(), 0, f.size() * sizeof(float));
+        quantize(qt[i], c->wt_cpu->ne[1], c->wt_cpu->ne[0]);
+        c->wt_cpu = qt[i];
+    }
+    if (verbose) {
+        fprintf(stderr, "nanocodec: Q8_0 CPU weights for %zu convolutions and %zu transposed\n",
+                convs.size(), transposed.size());
+    }
+}
+
+// y [T_out, Cout, 1] = conv1d(x) without bias; x already padded in time (and channels).
+static ggml_tensor*
+nc_cpu_conv1d(ggml_context* ctx, const nc_conv& conv, ggml_tensor* x) {
+    if (!conv.wq_cpu) {
+        return ggml_conv_1d(ctx, conv.w_cpu ? conv.w_cpu : conv.w, x, conv.stride, 0, conv.dilation);
+    }
+    ggml_tensor* cols = ggml_im2col(
+        ctx, conv.wq_shape, x, conv.stride, 0, 0, 0, conv.dilation, 0, false, GGML_TYPE_F32);
+    // cols [K * Cin, T_out, 1]; result [Cout, T_out] -> [T_out, Cout, 1]
+    ggml_tensor* y = ggml_mul_mat(ctx, conv.wq_cpu, ggml_reshape_2d(ctx, cols, cols->ne[0], cols->ne[1]));
+    y = ggml_cont(ctx, ggml_transpose(ctx, y));
+    return ggml_reshape_3d(ctx, y, y->ne[0], y->ne[1], 1);
+}
