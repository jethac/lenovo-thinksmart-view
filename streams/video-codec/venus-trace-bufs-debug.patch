@@ -532,6 +532,12 @@ session_process_buf(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 		fdata.offset = 0;
 	}
 
+	if (venus_trace)
+		dev_info(inst->core->dev, "%s qbuf %s idx %u addr 0x%x alloc %u filled %u off %u flags 0x%x\n",
+			 inst->session_type == VIDC_SESSION_TYPE_ENC ? "enc" : "dec",
+			 V4L2_TYPE_IS_OUTPUT(type) ? "in " : "out", fdata.clnt_data, fdata.device_addr,
+			 fdata.alloc_len, fdata.filled_len, fdata.offset, fdata.flags);
+
 	return hfi_session_process_buf(inst, &fdata);
 }
 
@@ -1371,6 +1377,8 @@ static void delayed_process_buf_func(struct work_struct *work)
 		if (buf->flags & HFI_BUFFERFLAG_READONLY)
 			continue;
 
+		if (venus_trace)
+			dev_info(inst->core->dev, "resend idx %u\n", buf->vb.vb2_buf.index);
 		ret = session_process_buf(inst, &buf->vb);
 		if (ret)
 			return_buf_error(inst, &buf->vb);
@@ -1385,6 +1393,8 @@ void venus_helper_release_buf_ref(struct venus_inst *inst, unsigned int idx)
 {
 	struct venus_buffer *buf;
 
+	if (venus_trace)
+		dev_info(inst->core->dev, "release ref idx %u\n", idx);
 	list_for_each_entry(buf, &inst->registeredbufs, reg_list) {
 		if (buf->vb.vb2_buf.index == idx) {
 			buf->flags &= ~HFI_BUFFERFLAG_READONLY;
@@ -1408,6 +1418,8 @@ static int is_buf_refed(struct venus_inst *inst, struct vb2_v4l2_buffer *vbuf)
 	struct venus_buffer *buf = to_venus_buffer(vbuf);
 
 	if (buf->flags & HFI_BUFFERFLAG_READONLY) {
+		if (venus_trace)
+			dev_info(inst->core->dev, "park idx %u\n", vbuf->vb2_buf.index);
 		list_add_tail(&buf->ref_list, &inst->delayed_process);
 		schedule_work(&inst->delayed_process_work);
 		return 1;
